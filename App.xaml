<Application x:Class="Canopy.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Color Palette (Caelestia Shell Dark Notch Aesthetic) -->
        <Color x:Key="CardBackgroundColor">#D9121216</Color>
        <Color x:Key="CardBorderColor">#22FFFFFF</Color>
        <Color x:Key="PillSurfaceColor">#1AFFFFFF</Color>
        <Color x:Key="AccentCyanColor">#38BDF8</Color>
        <Color x:Key="AccentPurpleColor">#A855F7</Color>
        <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
        <Color x:Key="TextSecondaryColor">#94A3B8</Color>
        <Color x:Key="TextMutedColor">#64748B</Color>

        <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
        <SolidColorBrush x:Key="PillSurfaceBrush" Color="{StaticResource PillSurfaceColor}" />
        <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyanColor}" />
        <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurpleColor}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

        <LinearGradientBrush x:Key="CapsuleFillBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3838BDF8" Offset="0.0" />
            <GradientStop Color="#5838BDF8" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Minimal Mute Icon Button Inside Capsule -->
        <Style x:Key="CapsuleMuteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Width="28"
                                Height="26"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#35FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Capsule Slider Left (Filled Portion) -->
        <Style x:Key="CapsuleSliderDecreaseButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="34"
                                CornerRadius="10,0,0,10"
                                Background="{StaticResource CapsuleFillBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Capsule Slider Right (Unfilled Portion) -->
        <Style x:Key="CapsuleSliderIncreaseButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="34"
                                Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Capsule Slider Thumb (Vertical Pill Indicator) -->
        <Style x:Key="CapsuleSliderThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border x:Name="ThumbBar"
                                    Width="3.5"
                                    Height="16"
                                    CornerRadius="1.75"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Background="#D8F8FAFC" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBar" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="ThumbBar" Property="Height" Value="20" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBar" Property="Background" Value="#38BDF8" />
                                <Setter TargetName="ThumbBar" Property="Height" Value="22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern 34px Rounded Capsule Volume Slider -->
        <Style x:Key="CaelestiaVolumeSliderStyle" TargetType="Slider">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Border Height="34"
                                CornerRadius="11"
                                Background="Transparent"
                                ClipToBounds="True">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource CapsuleSliderDecreaseButton}"
                                                  Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource CapsuleSliderIncreaseButton}"
                                                  Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource CapsuleSliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
