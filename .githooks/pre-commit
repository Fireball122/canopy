#!/bin/sh
# Canopy Verification Cage Pre-Commit Gatekeeper
echo "=================================================="
echo "  CANOPY PRE-COMMIT: RUNNING VERIFICATION CAGE    "
echo "=================================================="

# Run verification script
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "./verify.ps1"
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "=================================================="
  echo " [FAIL] PRE-COMMIT BLOCKED: VERIFICATION FAILED   "
  echo " Fix compiler/linter/type errors before committing."
  echo "=================================================="
  exit 1
fi

exit 0
