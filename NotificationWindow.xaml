<Window x:Class="CaelestiaWin.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Canopy Notification"
        Width="500"
        Height="100"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseEnter="OnMouseEnterPill"
        MouseLeave="OnMouseLeavePill"
        Loaded="OnWindowLoaded">
    <Grid Width="500" Height="100" HorizontalAlignment="Center" VerticalAlignment="Top">
        <!-- The Animated Raindrop -> Pill Capsule -->
        <Border x:Name="NotificationPill"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="40"
                Height="40"
                Background="#EE0F111A"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="20"
                ClipToBounds="True"
                RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24"
                                  Color="#000000"
                                  Opacity="0.45"
                                  ShadowDepth="5"
                                  Direction="270" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="PillTranslate" Y="-50" />
            </Border.RenderTransform>

            <Grid Height="40" Margin="7,0,9,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon Badge (acts as raindrop head, then badge in pill) -->
                <Border x:Name="IconBadge"
                        Grid.Column="0"
                        Width="26"
                        Height="26"
                        CornerRadius="13"
                        Background="#26CBA6F7"
                        BorderBrush="#4DCBA6F7"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Path Data="M 7 13 A 2 2 0 0 0 11 13 M 9 3 C 6.5 3 5 5 5 8 C 5 10 4 11 3 12 L 15 12 C 14 11 13 10 13 8 C 13 5 11.5 3 9 3 Z"
                          Fill="#FFCBA6F7"
                          Width="12"
                          Height="12"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>

                <!-- Notification Content (fades in as pill expands) -->
                <StackPanel x:Name="TextContainer"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="8,0,10,0"
                            Opacity="0">
                    <TextBlock x:Name="TitleText"
                               Text="REMINDER"
                               FontSize="9.5"
                               FontWeight="Bold"
                               Foreground="#CBA6F7"
                               FontFamily="Segoe UI Variable Text, Segoe UI" />
                    <TextBlock x:Name="MessageText"
                               Text="Reminder notification text"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="#F8FAFC"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="380" />
                </StackPanel>

                <!-- Dismiss Button -->
                <Button x:Name="DismissButton"
                        Grid.Column="2"
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Opacity="0"
                        Click="OnDismissClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="10" Width="20" Height="20">
                                <Path Data="M 4 4 L 10 10 M 10 4 L 4 10"
                                      Stroke="#94A3B8"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="8"
                                      Height="8"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#22FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
