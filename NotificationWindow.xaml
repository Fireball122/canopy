<Window x:Class="Canopy.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Canopy Notification"
        Width="600"
        Height="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseEnter="OnMouseEnterPill"
        MouseLeave="OnMouseLeavePill"
        Loaded="OnWindowLoaded">
    <Grid Width="600" Height="120" HorizontalAlignment="Center" VerticalAlignment="Top">
        <!-- The Animated Raindrop -> Pill Capsule (Never turns into a rectangle: CornerRadius=24) -->
        <Border x:Name="NotificationPill"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="48"
                Height="48"
                Background="#F0111913"
                BorderBrush="#4D74A86C"
                BorderThickness="1"
                CornerRadius="24"
                ClipToBounds="True"
                RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect x:Name="PillShadow"
                                  BlurRadius="28"
                                  Color="#74A86C"
                                  Opacity="0.45"
                                  ShadowDepth="6"
                                  Direction="270" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="PillTranslate" Y="-70" />
            </Border.RenderTransform>

            <Grid Height="48">
                <!-- Inner Row Layout: Icon Badge -> Text -> Dismiss Button -->
                <Grid Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon Badge (purely hidden during bead drop/retract, reveals when mostly expanded) -->
                    <Border x:Name="IconBadge"
                            Grid.Column="0"
                            Width="30"
                            Height="30"
                            CornerRadius="15"
                            Background="#2674A86C"
                            BorderBrush="#4D74A86C"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="IconScale" ScaleX="0.5" ScaleY="0.5" />
                        </Border.RenderTransform>
                        <Path x:Name="BellPath"
                              Data="M 7 13 A 2 2 0 0 0 11 13 M 9 3 C 6.5 3 5 5 5 8 C 5 10 4 11 3 12 L 15 12 C 14 11 13 10 13 8 C 13 5 11.5 3 9 3 Z"
                              Fill="#FF74A86C"
                              Width="13"
                              Height="13"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>

                    <!-- Notification Content: Category + Title (Zero vertical clipping) -->
                    <StackPanel x:Name="TextContainer"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="10,0,12,0"
                                Opacity="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                            <TextBlock x:Name="TitleText"
                                       Text="REMINDER"
                                       FontSize="9.5"
                                       FontWeight="Bold"
                                       Foreground="#74A86C"
                                       FontFamily="Segoe UI Variable Text, Segoe UI" />
                            <TextBlock Text=" • Just now"
                                       FontSize="9"
                                       Foreground="#64748B"
                                       FontFamily="Segoe UI Variable Text, Segoe UI" />
                        </StackPanel>
                        <TextBlock x:Name="MessageText"
                                   Text="Reminder notification text"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#F8FAFC"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="420" />
                    </StackPanel>

                    <!-- Dismiss Button: Firmly pinned on the right -->
                    <Button x:Name="DismissButton"
                            Grid.Column="2"
                            Width="22"
                            Height="22"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Opacity="0"
                            Click="OnDismissClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="11" Width="22" Height="22">
                                    <Path Data="M 4 4 L 10 10 M 10 4 L 4 10"
                                          Stroke="#94A3B8"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="9"
                                          Height="9"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#22FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Auto-Dismiss Countdown Line at Bottom -->
                <Border VerticalAlignment="Bottom" Height="2" Background="#11FFFFFF">
                    <Border x:Name="CountdownBar"
                            Height="2"
                            HorizontalAlignment="Left"
                            Background="#74A86C"
                            Width="0" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
